<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Liyab's executables on Windows: UTF-8 as the process's ANSI code page
  (Windows 10 1903 and later; ignored before), so main()'s arguments, getenv()
  and the C runtime's narrow file functions use UTF-8, the encoding of every
  string in Liyab. Embedded by CMakeLists.txt (as a manifest source with MSVC
  and clang-cl, through utf8.rc otherwise).
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
